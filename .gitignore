# Python bytecode / caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/
wheelhouse/

# Test / coverage / tooling caches
.pytest_cache/
.coverage*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Logs and local outputs
*.log
pytest_output.txt

# IDE / Editor metadata
.idea/
.vscode/
.history/
*.code-workspace
.kiro/

# OS files
.DS_Store
Thumbs.db

# Environment & secrets (do not commit)
*.env
.env*
*.key
*.pem

# Temporary / backup files
*.tmp
*.bak
*.swp
*.swo
~$*

# Project-specific
**/*.pdf
gitignore/
graph_backups/
backups/
config/*
!config/tools.json
!config/help.json
!config/workflows.json
!config/admin.json

