        "create", "stats", "drop", "truncate",
        "backup"
      ]
    },
    {
      "name": "arango_view",
      "category": "view",
      "description": "search_tools first for params. View: create|drop|list|get|update|search",
      "dispatch": "action-based",
      "actions": ["create", "drop", "list", "get", "update", "search"]
    },
    {
      "name": "arango_graph",
      "category": "graph",
      "description": "search_tools first for params. Graph: create|list|add_vertex_collection|add_edge_definition|add_edge|traverse|shortest_path|backup|restore|backup_named|validate_integrity|statistics",
      "dispatch": "action-based",
